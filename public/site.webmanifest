{
  "id": "/",
  "name": "OneKVM",
  "short_name": "OneKVM",
  "description": "Remote console and device administration for OneKVM.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#061A3A",
  "background_color": "#061A3A",
  "categories": ["utilities"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing"]
  },
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/onekvm-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
