{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/main.ts",
    "src/App.vue",
    "src/components/**/*.vue",
    "src/extensions/**/*.ts",
    "src/composables/**/*.ts",
    "src/api/client.ts",
    "src/lib/onekvm.ts",
    "src/product/**/*.ts",
    "src/i18n/runtime.ts",
    "src/i18n/languages.ts",
    "src/i18n/locales/**/*.ts",
    "src/input/**/*.ts",
    "src/vite-env.d.ts",
    "src/recovery/**/*.ts",
    "src/recovery/**/*.vue"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
